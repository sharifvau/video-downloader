# ---- Public URL (recommended in production; used to build signed proxy links) ----
PUBLIC_BASE_URL=https://your-domain.com

# ---- Security ----
# Secret used to sign download-proxy links. REQUIRED on Vercel (instances don't share memory).
# Generate: openssl rand -hex 32
PROXY_SECRET=
# Comma-separated API keys for /api/v1/alldown. Leave empty to keep the API open.
API_KEYS=
# Allowed browser origin for the public API ("*" = any).
CORS_ORIGIN=*

# ---- Rate limiting (in-memory, per instance) ----
RATE_LIMIT_MAX=30
RATE_LIMIT_WINDOW_SEC=60
WEB_RATE_LIMIT_MAX=20

# ---- Limits ----
MAX_DOWNLOAD_MB=2048
FETCH_TIMEOUT_MS=10000

# ---- Providers ----
# yt-dlp provider (enabled automatically inside the Docker image).
YTDLP_ENABLED=false
YTDLP_PATH=yt-dlp
# Cobalt-compatible extraction API (self-hosted instance recommended). Works on Vercel.
COBALT_API_URL=
COBALT_API_KEY=
COBALT_QUALITIES=1080,720,480

# ---- Branding links ----
NEXT_PUBLIC_CONTACT_URL=https://github.com/sharifvau
